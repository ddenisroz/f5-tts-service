# f5-tts-service minimal env example
# Most synthesis, upload, limits, and transcriber options already have sane defaults in app/config.py.

F5_TTS_SERVICE_HOST=0.0.0.0
F5_TTS_SERVICE_PORT=8011
F5_TTS_SERVICE_PUBLIC_BASE_URL=http://localhost:8011
F5_TTS_SERVICE_API_KEYS=change-me

# Leave empty to use file-based state. Set PostgreSQL only if you want DB-backed voices/limits.
F5_TTS_DATABASE_URL=

# Change these only if your repo layout differs from the default.
F5_TTS_UPSTREAM_DIR=vendor/F5-TTS
F5_TTS_RUSSIAN_WEIGHTS_DIR=models/F5-TTS_RUSSIAN
F5_TTS_HF_CACHE_DIR=models/cache

# Persistent runtime storage.
F5_TTS_VOICES_DIR=data/voices
F5_TTS_AUDIO_DIR=data/audio
